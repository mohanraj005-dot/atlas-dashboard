{
  "name": "atlas-dashboard",
  "version": "0.1.0",
  "description": "Cross-project status dashboard: a local collector reads git and planning files, a Cloudflare Worker + D1 stores signed snapshots and serves a read-only view.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run && node --test tests/checks.test.mjs tests/collector/*.test.mjs",
    "test:worker": "vitest run",
    "test:node": "node --test tests/checks.test.mjs tests/collector/*.test.mjs",
    "migrate:local": "wrangler d1 migrations apply atlas --local",
    "migrate:remote": "wrangler d1 migrations apply atlas --remote",
    "check": "node checks.mjs",
    "demo": "node scripts/demo-seed.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
